{
  "name": "soblendwa-node",
  "version": "0.2.0",
  "description": "WhatsApp Web multi-device for Node.js, running on the SoblendWA Rust engine. By Soblend Development Studio.",
  "author": "Soblend Development Studio",
  "license": "MIT",
  "homepage": "https://github.com/Soblend-Development-Studio/SoblendWA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soblend-Development-Studio/SoblendWA.git",
    "directory": "bindings/node"
  },
  "bugs": { "url": "https://github.com/Soblend-Development-Studio/SoblendWA/issues" },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "store-check.js",
    "live-check.js",
    "soak.js",
    "soblendwa.win32-x64-msvc.node",
    "soblendwa.linux-x64-gnu.node",
    "soblendwa.linux-arm64-gnu.node",
    "soblendwa.darwin-x64.node",
    "soblendwa.darwin-arm64.node"
  ],
  "engines": { "node": ">=18" },
  "keywords": ["whatsapp", "baileys", "bot", "rust", "napi", "multi-device"],
  "napi": {
    "binaryName": "soblendwa",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-js --dts native.d.ts",
    "prepublishOnly": "node check-package.js",
    "test": "node test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  }
}
